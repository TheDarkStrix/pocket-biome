extends RefCounted
# Engine-rendered UI assets generated by tools/capture_diorama_previews.gd.
static var cache:Dictionary={}
static func texture(type:String,evolution:String="") -> Texture2D:
 var key:String=evolution if evolution!="" else type
 if not cache.has(key):
  var path:String="res://assets/diorama_previews/"+key+".png"
  if not ResourceLoader.exists(path):return null
  cache[key]=load(path)
 return cache[key]
static func paint(canvas:CanvasItem,type:String,evolution:String,area:Rect2,silhouette:bool=false) -> bool:
 var art:Texture2D=texture(type,evolution)
 if art==null:return false
 var edge:float=minf(area.size.x,area.size.y)
 canvas.draw_texture_rect(art,Rect2(area.get_center()-Vector2.ONE*edge/2,Vector2.ONE*edge),false,Color("2d3d37") if silhouette else Color.WHITE)
 return true
